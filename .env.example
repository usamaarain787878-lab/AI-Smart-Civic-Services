# Application Settings
PORT=5000
NODE_ENV=development

# Database Configuration (Using civic_services.db as primary)
DATABASE_URL=sqlite:///civic_services.db

# Flask / Python Secret Key
SECRET_KEY=super_secret_key_change_this_in_production

# Next.js Public API URL (Local ke liye localhost, live hone par production URL aa jayega)
NEXT_PUBLIC_API_URL=http://localhost:5000
